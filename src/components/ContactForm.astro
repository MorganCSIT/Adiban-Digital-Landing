---
import { siteConfig } from '../config/site';

const formAction = `https://formsubmit.co/${siteConfig.email}`;
const successUrl = `${siteConfig.url}/contact?sent=1`;
---

<div id="meeting-request">
  <div id="form-success" class="hidden flex-col items-center justify-center py-20 text-center">
    <div class="p-[3px] rounded-squircle bg-emerald-100/50 ring-1 ring-emerald-200/70 mb-5 inline-block">
      <div class="w-14 h-14 rounded-squircle-in bg-emerald-50 flex items-center justify-center">
        <svg class="w-7 h-7 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
        </svg>
      </div>
    </div>
    <h3 class="font-heading font-semibold text-xl text-brand-heading tracking-tight mb-2">Call request received</h3>
    <p class="text-brand-muted text-sm">Thanks. I’ll reply with the next available times.</p>
  </div>

  <form
    id="contact-form"
    action={formAction}
    method="POST"
    accept-charset="UTF-8"
    class="space-y-4"
  >
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_subject" value="New Adiban Digital 30-minute call request" />
    <input id="form-next" type="hidden" name="_next" value={successUrl} />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="name" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">Name <span class="text-brand-accent">*</span></label>
        <input id="name" type="text" name="name" required placeholder="Your name"
          class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading placeholder-brand-muted text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300"
        />
      </div>
      <div class="space-y-1.5">
        <label for="email" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">Email <span class="text-brand-accent">*</span></label>
        <input id="email" type="email" name="email" required placeholder="you@company.com"
          class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading placeholder-brand-muted text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300"
        />
      </div>
    </div>

    <div class="space-y-1.5">
      <label for="company" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">Company <span class="text-brand-muted normal-case tracking-normal font-normal">optional</span></label>
      <input id="company" type="text" name="company" placeholder="Your company"
        class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading placeholder-brand-muted text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300"
      />
    </div>

    <div class="space-y-1.5">
      <label for="problem" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">What would you like to improve? <span class="text-brand-accent">*</span></label>
      <textarea id="problem" name="problem" required rows="4"
        placeholder="For example: we waste hours copying data between systems, our website gets traffic but few enquiries, or I want to automate a repetitive process..."
        class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading placeholder-brand-muted text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300 resize-none"
      ></textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="contactPreference" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">Best way to reply</label>
        <select id="contactPreference" name="contactPreference"
          class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300"
        >
          <option value="email">Email</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="phone">Phone</option>
        </select>
      </div>
      <div class="space-y-1.5">
        <label for="phone" class="block text-xs font-medium text-brand-heading uppercase tracking-wider">Phone / WhatsApp <span class="text-brand-muted normal-case tracking-normal font-normal">optional</span></label>
        <input id="phone" type="tel" name="phone" placeholder="+66 ..."
          class="w-full px-4 py-3 rounded-xl bg-brand-bg ring-1 ring-black/[0.08] text-brand-heading placeholder-brand-muted text-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/30 transition-all duration-300"
        />
      </div>
    </div>

    <button
      type="submit"
      class="group w-full flex items-center justify-between pl-6 pr-1.5 py-2 rounded-full bg-brand-heading text-white font-medium text-sm hover:bg-brand-accent transition-all duration-600 ease-spring shadow-soft-md hover:shadow-accent-glow active:scale-[0.99]"
    >
      Request My Free 30-Minute Call
      <span class="w-8 h-8 rounded-full bg-white/15 flex items-center justify-center transition-all duration-300 ease-spring group-hover:bg-white/20 group-hover:translate-x-0.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    </button>

    <p class="text-center text-xs text-brand-muted">
      No proposal form and no sales presentation. Just enough context for a useful first conversation.
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  const next = document.getElementById('form-next') as HTMLInputElement | null;
  const params = new URLSearchParams(window.location.search);

  if (next) {
    next.value = `${window.location.origin}/contact?sent=1`;
  }

  if (params.get('sent') === '1' && form && success) {
    form.classList.add('hidden');
    success.classList.remove('hidden');
    success.classList.add('flex');
    window.history.replaceState({}, document.title, window.location.pathname);
  }
</script>
