---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { bookingHref } from '../config/site';

const approach = [
  { number: '01', title: 'Understand the operation', description: 'Learn how the team actually works: the software, spreadsheets, manual steps, workarounds, constraints, and edge cases.' },
  { number: '02', title: 'Find the leverage point', description: 'Identify where time, information, or money is being lost, and where a focused technical intervention can make a meaningful difference.' },
  { number: '03', title: 'Build around reality', description: 'Connect existing tools, automate repetitive steps, and build custom software only where off-the-shelf products are not enough.' },
  { number: '04', title: 'Stay through deployment', description: 'Test with real data, validate edge cases, gather feedback, deploy carefully, and improve the system once people start using it.' },
];

const principles = [
  'Start with the business problem, not a preferred technology.',
  'Integrate useful existing systems before proposing wholesale replacement.',
  'Choose the simplest architecture that can be maintained responsibly.',
  'Treat privacy, security, and data sensitivity as design constraints from the start.',
  'Use AI where it provides genuine value, not because it is fashionable.',
];

const capabilities = [
  'Software engineering and web applications',
  'Python, data processing, and transformation',
  'Internal tools, dashboards, and reporting',
  'APIs, systems integration, and automation',
  'Workflow analysis and technical scoping',
  'AI-assisted development and practical AI use cases',
  'Deployment, iteration, and ongoing support',
];

const fitExamples = [
  'We export data from three systems every week and reconcile it manually.',
  'Our team relies on a spreadsheet because our main software does not handle this workflow.',
  'Two systems contain related data but do not communicate.',
  'We spend hours checking the same things manually.',
  'We know AI could help somewhere, but not where it would actually be useful.',
  'We need a small internal application built around our process.',
];

const workflow = ['Understand', 'Reconcile', 'Automate', 'Validate', 'Deploy', 'Improve'];
---

<BaseLayout
  title="Morgan Kieffer | Founder & Forward Deployed Engineer | Adiban Digital"
  description="Meet Morgan Kieffer, founder of Adiban Digital. I work directly with businesses to improve operational workflows through software, automation, systems integration, and practical AI."
>
  <Nav />
  <main>
    <section class="pt-32 pb-24 px-4 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-fine opacity-100 pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-12 items-end">
        <div data-reveal>
          <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-4">Founder</p>
          <h1 class="font-heading font-bold text-5xl lg:text-7xl text-brand-heading tracking-[-0.04em] leading-[0.95] mb-5">Morgan Kieffer</h1>
          <p class="font-heading font-semibold text-xl lg:text-2xl text-brand-accent mb-6">Founder &amp; Forward Deployed Engineer</p>
          <p class="text-lg text-brand-text leading-relaxed max-w-[62ch] mb-8">Part software engineer, part systems integrator, part problem solver. I work directly with businesses to understand how their operations actually work, identify bottlenecks, and build the systems needed to fix them.</p>
          <div class="flex flex-wrap items-center gap-4">
            <a href={bookingHref} class="group inline-flex items-center justify-between pl-5 pr-1.5 py-2 rounded-full bg-brand-heading text-white font-medium text-sm hover:bg-brand-accent transition-all duration-[600ms] ease-spring shadow-soft-md hover:shadow-accent-glow active:scale-[0.99]">
              Discuss an operational problem
              <span class="ml-3 w-7 h-7 rounded-full bg-white/15 flex items-center justify-center transition-all duration-300 ease-spring group-hover:bg-white/20 group-hover:translate-x-0.5"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
            </a>
            <span class="text-xs text-brand-muted">Based in Thailand, working remotely with businesses in Europe and internationally.</span>
          </div>
        </div>
        <div class="p-[3px] rounded-squircle bg-black/[0.03] ring-1 ring-black/[0.07]" data-reveal data-delay="1">
          <div class="bg-white rounded-squircle-in shadow-inner-highlight p-7 lg:p-8">
            <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-5">The operating principle</p>
            <p class="font-heading font-semibold text-xl text-brand-heading leading-snug">I do not start with a technology and look for somewhere to use it.</p>
            <p class="text-brand-text text-sm leading-relaxed mt-4">I start with the workflow, find where time, information, or money is being lost, and build the simplest system that solves the problem.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-28 px-4 bg-brand-surface1 border-y border-brand-border">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 mb-12 items-end" data-reveal>
          <div>
            <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-3">The role, in practice</p>
            <h2 class="font-heading font-bold text-3xl lg:text-4xl text-brand-heading leading-tight">What a Forward Deployed Engineer actually does</h2>
          </div>
          <p class="text-brand-text leading-relaxed max-w-[58ch] lg:pb-1">It means working close to the people and processes affected by the software—not disappearing with a specification and returning months later with a finished product.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" data-reveal data-delay="1">
          {approach.map((item) => (
            <div class="p-[3px] rounded-squircle bg-black/[0.03] ring-1 ring-black/[0.07]"><div class="bg-white rounded-squircle-in shadow-inner-highlight p-6 h-full">
              <span class="font-mono text-[10px] text-brand-muted block mb-4 tracking-[0.12em]">{item.number}</span>
              <h3 class="font-heading font-semibold text-brand-heading text-base mb-3">{item.title}</h3>
              <p class="text-brand-text text-sm leading-relaxed">{item.description}</p>
            </div></div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-28 px-4">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div data-reveal>
          <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-3">Technology philosophy</p>
          <h2 class="font-heading font-bold text-3xl lg:text-4xl text-brand-heading leading-tight mb-6">The goal is not more software. It is a better operation.</h2>
          <p class="text-brand-text leading-relaxed max-w-[58ch]">Technology should remove friction without creating a new maintenance burden. AI is one tool in the toolbox, not the starting point. Many valuable systems are straightforward software, automation, integrations, and careful data processing.</p>
          <p class="text-brand-text text-sm leading-relaxed max-w-[58ch] mt-4">Where data is sensitive—particularly in healthcare—the architecture must be chosen around privacy, security, and regulatory requirements. That may limit where external AI services are appropriate.</p>
        </div>
        <div class="p-[3px] rounded-squircle bg-black/[0.03] ring-1 ring-black/[0.07]" data-reveal data-delay="1"><div class="bg-white rounded-squircle-in shadow-inner-highlight p-7">
          <ul class="space-y-4">
            {principles.map((item) => (<li class="flex items-start gap-3"><svg class="w-4 h-4 text-brand-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg><span class="text-brand-text text-sm leading-relaxed">{item}</span></li>))}
          </ul>
        </div></div>
      </div>
    </section>

    <section class="py-28 px-4 bg-brand-surface1 border-y border-brand-border">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-12 items-start">
        <div data-reveal>
          <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-3">Operational experience</p>
          <h2 class="font-heading font-bold text-3xl lg:text-4xl text-brand-heading leading-tight mb-6">Working inside a real Swiss operation</h2>
          <p class="text-brand-text leading-relaxed">I have worked directly with a Swiss healthcare organization on internal systems used in day-to-day operational workflows. The work began by learning the existing process and understanding several business systems that were not designed to work together.</p>
          <p class="text-brand-text text-sm leading-relaxed mt-4">The work spans planning and scheduling data, employee activity records, vehicle and route data, cross-system reconciliation, automated SFTP and file workflows, auditing, verification, PDF reporting, and internal applications that help operational staff import, transform, check, and correct data.</p>
          <p class="text-brand-text text-sm leading-relaxed mt-4">The important part was not a particular technology. It was building around the way employees actually work, validating the difficult cases, and supporting the system as it met real operational data.</p>
        </div>
        <div class="p-[3px] rounded-squircle bg-black/[0.03] ring-1 ring-black/[0.07]" data-reveal data-delay="1"><div class="bg-white rounded-squircle-in shadow-inner-highlight p-7 lg:p-8">
          <p class="text-[10px] font-medium text-brand-muted uppercase tracking-[0.18em] mb-6">From disconnected inputs to a usable workflow</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {workflow.map((step, i) => (<div class="rounded-[1rem] bg-brand-surface1 ring-1 ring-black/[0.06] p-4"><span class="font-mono text-[10px] text-brand-muted block mb-2">{String(i + 1).padStart(2, '0')}</span><span class="font-heading font-semibold text-sm text-brand-heading">{step}</span></div>))}
          </div>
          <div class="mt-5 pt-5 border-t border-brand-border flex flex-wrap gap-2">
            {['Planning', 'Work records', 'Routes', 'Files', 'Reports', 'Internal apps'].map((source) => (<span class="px-3 py-1 rounded-full bg-white ring-1 ring-black/[0.07] text-xs text-brand-muted">{source}</span>))}
          </div>
        </div></div>
      </div>
    </section>

    <section class="py-28 px-4">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 items-start">
        <div data-reveal>
          <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-3">Background &amp; capabilities</p>
          <h2 class="font-heading font-bold text-3xl text-brand-heading leading-tight mb-5">Able to follow the problem across the stack</h2>
          <p class="text-brand-text text-sm leading-relaxed">I hold a Bachelor's degree in IT / Computer Science and work across analysis, implementation, deployment, and support. The focus is capability and fit, not forcing every project into the same stack.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-reveal data-delay="1">
          {capabilities.map((item, i) => (<div class="flex items-start gap-3 p-4 rounded-[1rem] bg-white ring-1 ring-black/[0.07] shadow-soft-xs"><span class="font-mono text-[10px] text-brand-muted mt-0.5">{String(i + 1).padStart(2, '0')}</span><span class="text-brand-text text-sm leading-relaxed">{item}</span></div>))}
        </div>
      </div>
    </section>

    <section class="py-28 px-4 bg-brand-surface1 border-y border-brand-border">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12" data-reveal>
          <p class="text-[10px] font-medium text-brand-accent uppercase tracking-[0.2em] mb-3">A good fit</p>
          <h2 class="font-heading font-bold text-3xl lg:text-4xl text-brand-heading leading-tight mb-4">Problems that are worth discussing</h2>
          <p class="text-brand-text leading-relaxed">The best starting point is usually a concrete workflow that feels more manual, fragmented, or error-prone than it should.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal data-delay="1">
          {fitExamples.map((example) => (<div class="p-[3px] rounded-squircle bg-black/[0.03] ring-1 ring-black/[0.07]"><div class="bg-white rounded-squircle-in shadow-inner-highlight p-6 h-full"><p class="font-heading font-medium text-brand-heading leading-relaxed">“{example}”</p></div></div>))}
        </div>
      </div>
    </section>

    <section class="py-28 px-4">
      <div class="max-w-7xl mx-auto" data-reveal>
        <div class="p-[3px] rounded-squircle bg-black/[0.04] ring-1 ring-black/[0.08]"><div class="rounded-squircle-in bg-brand-heading relative overflow-hidden">
          <div class="absolute inset-0 opacity-[0.055]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 items-center p-10 lg:p-14">
            <div>
              <p class="text-[10px] font-medium text-white/50 uppercase tracking-[0.2em] mb-3">A practical first conversation</p>
              <h2 class="font-heading font-bold text-3xl lg:text-4xl text-white leading-tight">Bring me one messy workflow.</h2>
              <p class="text-white/60 mt-3 text-base max-w-[60ch] leading-relaxed">Show me how the process works today. I will help identify where technology can realistically remove friction and what the simplest useful first version would look like.</p>
            </div>
            <a href={bookingHref} class="group inline-flex items-center justify-between pl-6 pr-1.5 py-2 rounded-full bg-white text-brand-heading font-medium text-sm hover:bg-brand-accent hover:text-white transition-all duration-[600ms] ease-spring shadow-soft-md active:scale-[0.99] flex-shrink-0">
              Book a Free 30-Minute Call
              <span class="ml-3 w-8 h-8 rounded-full bg-brand-heading/10 flex items-center justify-center transition-all duration-300 ease-spring group-hover:bg-white/20 group-hover:translate-x-0.5"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
            </a>
          </div>
        </div></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
